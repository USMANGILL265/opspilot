# ==========================================
# OpsPilot - Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET=super_secret_production_jwt_key_opspilot_2026_dev_secure_key_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=opspilot_session

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:Doorsandlocks@123@db.welgsciqpqhflmcrtfpf.supabase.co:5432/postgres?schema=public"

# Redis & Caching
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Background Queue
QUEUE_NAME=ticket-ai-queue
CONCURRENCY=5

# AI Provider Configuration
# Options: "gemini" | "openai" | "ollama" | "fallback" | "auto"
AI_PROVIDER=fallback
AI_MODEL_FALLBACK=heuristic-nlp-v1

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Configuration (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Observability & Logging
LOG_LEVEL=info
ENABLE_METRICS=true
